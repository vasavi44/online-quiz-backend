# Backend Environment Variables Template
PORT=8080

# Database Configuration (PostgreSQL on Render, or local)
# Render automatically provides DATABASE_URL when PostgreSQL database is attached.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/quizdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Security & JWT Configuration (must be at least 32 characters for HMAC-SHA256)
JWT_SECRET=replace_with_a_super_secret_key_at_least_32_characters_long!

# Allowed CORS Origins (comma separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-frontend-domain.vercel.app
